#!/usr/bin/env python3
"""Stand-in for vibe-acp in screenshot runs: answers the ACP requests the
app sends and replays the prepared sessions of $DEMO_SCENARIO on
session/load. No network, no model."""
import json, os, sys

sc = json.load(open(os.environ["DEMO_SCENARIO"]))
probe = 0

def send(msg):
    sys.stdout.write(json.dumps(msg) + "\n")
    sys.stdout.flush()

def result(rid, res):
    send({"jsonrpc": "2.0", "id": rid, "result": res})

def update(sid, upd):
    send({"jsonrpc": "2.0", "method": "session/update", "params": {"sessionId": sid, "update": upd}})

perm_n = [0]
COMMANDS = [{"name": n, "description": d} for n, d in [
    ("compact", "Compact the conversation"), ("help", "Show help"), ("retry", "Retry")]]

for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    msg = json.loads(line)
    method, rid, p = msg.get("method"), msg.get("id"), msg.get("params") or {}
    if rid is None:
        continue  # notifications (session/cancel)
    if method == "initialize":
        result(rid, {"protocolVersion": 1,
                     "agentCapabilities": {"loadSession": True,
                                           "promptCapabilities": {"image": True, "audio": False, "embeddedContext": True},
                                           "sessionCapabilities": {"list": {}, "fork": {}, "close": {}}},
                     "authMethods": [],
                     "agentInfo": {"name": "@mistralai/mistral-vibe", "title": "Mistral Vibe", "version": "3.1.2"}})
    elif method == "session/new":
        probe += 1
        sid = f"probe-{probe}"
        result(rid, {"sessionId": sid, "modes": sc["probe"]["modes"], "configOptions": sc["probe"]["configOptions"],
                     "_meta": {"workspace_trust": {"status": "trusted", "details": None}}})
        update(sid, {"sessionUpdate": "available_commands_update", "availableCommands": COMMANDS})
    elif method == "session/list":
        result(rid, {"sessions": sc["lists"].get(p.get("cwd", ""), [])})
    elif method == "session/load":
        s = sc["sessions"].get(p["sessionId"])
        if s is None:
            send({"jsonrpc": "2.0", "id": rid, "error": {"code": -32602, "message": "Session not found"}})
            continue
        for upd in s["updates"]:
            update(p["sessionId"], upd)
        result(rid, {"modes": s["modes"], "configOptions": s["configOptions"],
                     "_meta": {"workspace_trust": {"status": "trusted", "details": None}}})
        update(p["sessionId"], {"sessionUpdate": "available_commands_update", "availableCommands": COMMANDS})
    elif method == "session/prompt":
        # a session's own live turn (subagents), else the shared one
        live = sc.get("live_by_session", {}).get(p.get("sessionId", "")) or sc.get("live")
        if not live:
            result(rid, {})
        else:
            # scripted live turn for the screenshots: updates, a permission
            # request that stays open, then the prompt finishes (or fails)
            sid = p.get("sessionId", "")
            # like Vibe, echo the prompt as the turn's user message first
            text = "".join(b.get("text", "") for b in p.get("prompt", []) if b.get("type") == "text")
            update(sid, {"sessionUpdate": "user_message_chunk", "messageId": f"user-live-{rid}",
                         "content": {"type": "text", "text": text}})
            for act in live.get("on_prompt", []):
                if "update" in act:
                    update(sid, act["update"])
                elif act.get("permission"):
                    perm_n[0] += 1
                    send({"jsonrpc": "2.0", "id": 900 + perm_n[0], "method": "session/request_permission",
                          "params": {"sessionId": sid,
                                     "toolCall": {"toolCallId": f"call-live-{perm_n[0]}", "title": act.get("title", "Editing analysis.py"), "kind": "edit", "status": "pending"},
                                     "options": [{"optionId": "allow_once", "name": "Allow once", "kind": "allow_once"},
                                                 {"optionId": "reject_once", "name": "Deny", "kind": "reject_once"}]}})
                elif "finish" in act:
                    # answered at its position in the script, so later actions
                    # (e.g. a fresh permission request) land after the turn
                    if act["finish"] == "error":
                        send({"jsonrpc": "2.0", "id": rid, "error": {"code": -31001, "message": "rate limited"}})
                    else:
                        result(rid, {"stopReason": "end_turn"})
    elif method == "session/resume":
        result(rid, {})
    elif method == "_account/read":
        result(rid, sc["account"])
    elif method == "_identity/read":
        result(rid, sc["identity"])
    elif method == "_loops/list":
        result(rid, {"loops": []})
    elif method == "_review/state":
        result(rid, {"files": [], "scopes": []})
    elif method == "_connectors/list":
        result(rid, {"connectors": [], "error": None})
    elif method == "_voice/transcribeStart":
        # dictation screenshot: Vibe starts recording and the first
        # recognised pieces arrive (the recording keeps running)
        result(rid, {"ok": True})
        for piece in sc.get("dictation", []):
            send({"jsonrpc": "2.0", "method": "_voice/transcriptionDelta", "params": {"text": piece}})
    elif method in ("_voice/transcribeStop", "_voice/transcribeCancel", "_voice/narrateCancel"):
        result(rid, {"ok": True})
    else:
        result(rid, {})
